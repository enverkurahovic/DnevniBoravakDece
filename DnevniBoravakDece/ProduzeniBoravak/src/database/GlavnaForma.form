              <SubComponents>
                <Component class="javax.swing.JTextArea" name="jTextArea1">
                  <Properties>
                    <Property name="columns" type="int" value="20"/>
                    <Property name="rows" type="int" value="5"/>
                    <Property name="text" type="java.lang.String" value="Prva forma &#x2013; Aktivnosti&#xa;&#xa;Prikazuje spisak svih aktivnosti u tabeli.&#xa;Klikom na red u tabeli, podaci se u&#x10d;itavaju u polja za izmenu.&#xa;Dugme Unesi dodaje novu aktivnost (sifra se dodeljuje automatski).&#xa;Dugme Izadji zatvara celu aplikaciju.&#xa;&#xa;Druga forma &#x2013; Statistika&#xa;&#xa;Otvara se klikom na dugme sa ikonom grafika u alatnoj traci.&#xa;Dugme Prikazi osvezava i prikazuje tabelu sa brojem dece po danima i grafikon.&#xa;Dugme Izadji zatvara formu i vra&#x107;a na po&#x10d;etnu.&#xa;Napomena&#xa;Baza podataka mora biti pokrenuta pre pokretanja aplikacije."/>
                  </Properties>
                </Component>
              </SubComponents>
            </Container>
          </SubComponents>
        </Container>
